# Keep secrets, local data and build output out of image build contexts.
.git
**/.env
**/.env.*
data/
**/*.pem
**/*.key
**/secrets/
**/node_modules
**/dist
**/coverage
**/.turbo
**/*.tsbuildinfo

# Local worktrees, test output and artifacts are not build inputs.
.claude/worktrees/
e2e/artifacts/
e2e/test-results/
