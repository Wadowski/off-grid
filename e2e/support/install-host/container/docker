set -eu

previous=
count=$#
while [ "$count" -gt 0 ]; do
  argument=$1
  shift
  replaced=$argument
  if [ "$previous" = --project-name ] && [ "$argument" = offgrid ]; then
    replaced=$E2E_INSTALL_PROJECT
  fi
  previous=$argument
  set -- "$@" "$replaced"
  count=$((count - 1))
done
exec /opt/docker-real/docker "$@"
