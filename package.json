{
  "name": "offgrid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose -f infra/compose/docker-compose.yml up --build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "verify": "node scripts/verify.mjs",
    "rules:for": "node scripts/rules-for.mjs",
    "check:rules": "node scripts/check-rules.mjs",
    "ui:screens": "node scripts/ui-screens.mjs",
    "wt:cleanup": "node scripts/wt-cleanup.mjs",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @offgrid/test-db build && node packages/test-db/dist/cli.js turbo run test && pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "audit:deps": "pnpm audit --audit-level high",
    "license:headers": "node scripts/spdx-headers.mjs",
    "license:headers:check": "node scripts/spdx-headers.mjs --check",
    "reuse:lint": "reuse lint",
    "dco:check": "node scripts/check-dco.mjs",
    "e2e": "pnpm --filter @offgrid/e2e e2e",
    "e2e:smoke": "pnpm --filter @offgrid/e2e e2e:smoke",
    "e2e:wip": "pnpm --filter @offgrid/e2e e2e:wip",
    "e2e:affected": "pnpm --filter @offgrid/e2e e2e:affected",
    "e2e:changed": "node scripts/e2e-changed.mjs",
    "e2e:stack:up": "pnpm --filter @offgrid/e2e e2e:stack:up",
    "e2e:stack:down": "pnpm --filter @offgrid/e2e e2e:stack:down",
    "lint:features": "pnpm --filter @offgrid/e2e lint:features",
    "lint:shell": "command -v shellcheck >/dev/null || { echo 'lint:shell needs shellcheck, install it with your package manager' >&2; exit 1; }; shellcheck -s sh $(find infra -name '*.sh')",
    "test:install-distros": "node scripts/install-distros.mjs",
    "check:boundaries": "depcruise apps modules packages --config .dependency-cruiser.cjs --output-type err-long",
    "check:agent-config": "node scripts/check-agent-config.mjs",
    "check:no-telemetry": "node scripts/check-no-telemetry.mjs",
    "check:wip-tags": "node scripts/check-wip-tags.mjs",
    "check:stack-egress": "node scripts/check-stack-egress.mjs",
    "check:compose": "node scripts/check-compose-no-published-ports.mjs && node scripts/generate-compose-production-configs.mjs --check",
    "compose:production:generate": "node scripts/generate-compose-production-configs.mjs",
    "gen:openapi": "pnpm --filter @offgrid/contracts gen:openapi",
    "gen:api": "pnpm --filter @offgrid/api-client gen:api",
    "check:contracts": "pnpm --filter @offgrid/contracts check:contracts",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@offgrid/contracts": "workspace:*",
    "@prisma/client": "7.10.1",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
