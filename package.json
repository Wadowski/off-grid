{
  "name": "offgrid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "audit:deps": "pnpm audit --audit-level high",
    "license:headers": "node scripts/spdx-headers.mjs",
    "license:headers:check": "node scripts/spdx-headers.mjs --check",
    "reuse:lint": "reuse lint",
    "dco:check": "node scripts/check-dco.mjs",
    "e2e": "echo 'e2e: not implemented yet (filled by a later issue)'",
    "check:boundaries": "depcruise apps modules packages --config .dependency-cruiser.cjs --output-type err-long",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
