                  "maxLength": 100
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "admin",
                    "member"
                  ]
                },
                "accent": {
                  "type": "string",
                  "enum": [
                    "blue",
                    "sky",
                    "teal",
                    "green",
                    "lime",
                    "amber",
                    "orange",
                    "red",
                    "pink",
                    "purple",
                    "indigo",
                    "slate"
                  ]
                },
                "purpose": {
                  "type": "string",
