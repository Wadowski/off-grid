        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "accent": {
            "type": "string",
            "enum": [
              "blue",
              "sky",
              "teal",
              "green",
              "lime",
              "amber",
              "orange",
              "red",
              "pink",
              "purple",
              "indigo",
              "slate"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "household",
              "getaway",
              "extended"
            ]
          }
        },
        "required": [
