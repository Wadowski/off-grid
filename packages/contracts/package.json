    "gen:openapi": "tsc -b && node dist/cli/gen-openapi.js",
    "check:contracts": "tsc -b && node dist/cli/check-contracts.js"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
