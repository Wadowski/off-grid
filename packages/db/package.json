{
  "name": "@offgrid/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "build": "pnpm generate && tsc -b",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit --composite false --incremental false",
    "lint": "pnpm generate && eslint .",
    "test": "pnpm generate && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@offgrid/test-db": "workspace:*",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1"
  }
}
