datasource db {
  provider = "postgresql"
  schemas  = ["identity", "family", "access", "calendar", "lists", "notes", "files", "food", "relations", "notifications", "export", "outbox"]
}

model Family {
  familyId  String         @id @map("family_id") @db.Uuid
  name      String         @db.VarChar(100)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  members   FamilyMember[]

  @@map("family")
  @@schema("family")
}

model FamilyMember {
  familyId String   @map("family_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  family   Family   @relation(fields: [familyId], references: [familyId])

  @@id([familyId, userId])
  @@map("family_member")
  @@schema("family")
}

model UserAccount {
  userId        String         @id @map("user_id") @db.Uuid
  email         String         @db.VarChar(254)
  displayName   String         @map("display_name") @db.VarChar(100)
  instanceRole  String         @map("instance_role")
  status        String         @default("active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  credential    Credential?
  sessions      Session[]
  recoveryCodes RecoveryCode[]
  passwordResets PasswordReset[]

  @@map("user_account")
  @@schema("identity")
}

model Credential {
  userId       String      @id @map("user_id") @db.Uuid
  passwordHash String      @map("password_hash")
  changedAt    DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)
  user         UserAccount @relation(fields: [userId], references: [userId])

  @@map("credential")
  @@schema("identity")
}

model Session {
  sessionId   String      @id @map("session_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  deviceLabel String?     @map("device_label") @db.VarChar(100)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt  DateTime    @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(6)
  revoked     Boolean     @default(false)
  refreshTokenHash String?   @unique @map("refresh_token_hash") @db.Text
  previousRefreshTokenHash String? @map("previous_refresh_token_hash") @db.Text
  rotatedAt   DateTime?   @map("rotated_at") @db.Timestamptz(6)
  accessTokenHash  String?   @unique @map("access_token_hash") @db.Text
  accessExpiresAt  DateTime? @map("access_expires_at") @db.Timestamptz(6)
  user        UserAccount @relation(fields: [userId], references: [userId])

  @@map("session")
  @@schema("identity")
}

model RecoveryCode {
  recoveryCodeId String      @id @map("recovery_code_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  codeHash       String      @map("code_hash")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt         DateTime?   @map("used_at") @db.Timestamptz(6)
  retiredAt      DateTime?   @map("retired_at") @db.Timestamptz(6)
  user           UserAccount @relation(fields: [userId], references: [userId])

  @@map("recovery_code")
  @@schema("identity")
}

model PasswordReset {
  passwordResetId String      @id @map("password_reset_id") @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  codeHash        String      @unique @map("code_hash")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime    @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime?   @map("used_at") @db.Timestamptz(6)
  retiredAt       DateTime?   @map("retired_at") @db.Timestamptz(6)
  user            UserAccount @relation(fields: [userId], references: [userId])

  @@map("password_reset")
  @@schema("identity")
}

model FirstAdminClaim {
  claimKey  String   @id @map("claim_key")
  claimedAt DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)

  @@map("first_admin_claim")
  @@schema("identity")
}

model InstanceSettings {
  settingKey       String  @id @map("setting_key")
  registrationOpen Boolean @map("registration_open")

  @@map("instance_settings")
  @@schema("identity")
}

generator client {
  provider            = "prisma-client"
  output              = "../../../node_modules/.prisma/offgrid-db"
  importFileExtension = "js"
}
