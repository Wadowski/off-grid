datasource db {
  provider = "postgresql"
  schemas  = ["identity", "family", "access", "calendar", "lists", "notes", "files", "food", "relations", "notifications", "export", "outbox", "observability"]
}

model Family {
  familyId    String             @id @map("family_id") @db.Uuid
  name        String             @db.VarChar(100)
  accent      String             @default("blue") @db.VarChar(20)
  purpose     String             @default("household") @db.VarChar(20)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  members     FamilyMember[]
  invitations FamilyInvitation[]

  @@map("family")
  @@schema("family")
}

model FamilyMember {
  familyId String   @map("family_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  role     String   @default("member")
  family   Family   @relation(fields: [familyId], references: [familyId])

  activeFamilies FamilyActiveFamily[]

  @@id([familyId, userId])
  @@map("family_member")
  @@schema("family")
}

model FamilyActiveFamily {
  sessionId  String       @id @map("session_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  familyId   String       @map("family_id") @db.Uuid
  selectedAt DateTime     @default(now()) @map("selected_at") @db.Timestamptz(6)
  member     FamilyMember @relation(fields: [familyId, userId], references: [familyId, userId], onDelete: Cascade)

  @@map("active_family")
  @@schema("family")
}

model FamilyInvitation {
  invitationId String    @id @map("invitation_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  codeHash     String    @unique @map("code_hash") @db.VarChar(64)
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedBy       String?   @map("used_by") @db.Uuid
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  family       Family    @relation(fields: [familyId], references: [familyId])

  @@map("invitation")
  @@schema("family")
}

model FamilyInvitationAttempt {
  userId      String    @id @map("user_id") @db.Uuid
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("invitation_attempt")
  @@schema("family")
}

model UserAccount {
  userId         String          @id @map("user_id") @db.Uuid
  email          String          @db.VarChar(254)
  displayName    String          @map("display_name") @db.VarChar(100)
  instanceRole   String          @map("instance_role")
  status         String          @default("active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  credential     Credential?
  sessions       Session[]
  recoveryCodes  RecoveryCode[]
  passwordResets PasswordReset[]
  notifications  Notification[]

  @@map("user_account")
  @@schema("identity")
}

model Credential {
  userId       String      @id @map("user_id") @db.Uuid
  passwordHash String      @map("password_hash")
  changedAt    DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)
  user         UserAccount @relation(fields: [userId], references: [userId])

  @@map("credential")
  @@schema("identity")
}

model Session {
  sessionId                String      @id @map("session_id") @db.Uuid
  userId                   String      @map("user_id") @db.Uuid
  deviceLabel              String?     @map("device_label") @db.VarChar(100)
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt               DateTime    @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt                DateTime    @map("expires_at") @db.Timestamptz(6)
  revoked                  Boolean     @default(false)
  refreshTokenHash         String?     @unique @map("refresh_token_hash") @db.Text
  previousRefreshTokenHash String?     @map("previous_refresh_token_hash") @db.Text
  rotatedAt                DateTime?   @map("rotated_at") @db.Timestamptz(6)
  accessTokenHash          String?     @unique @map("access_token_hash") @db.Text
  accessExpiresAt          DateTime?   @map("access_expires_at") @db.Timestamptz(6)
  user                     UserAccount @relation(fields: [userId], references: [userId])

  @@map("session")
  @@schema("identity")
}

model RecoveryCode {
  recoveryCodeId String      @id @map("recovery_code_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  codeHash       String      @map("code_hash")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt         DateTime?   @map("used_at") @db.Timestamptz(6)
  retiredAt      DateTime?   @map("retired_at") @db.Timestamptz(6)
  user           UserAccount @relation(fields: [userId], references: [userId])

  @@map("recovery_code")
  @@schema("identity")
}

model PasswordReset {
  passwordResetId String      @id @map("password_reset_id") @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  codeHash        String      @unique @map("code_hash")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime    @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime?   @map("used_at") @db.Timestamptz(6)
  retiredAt       DateTime?   @map("retired_at") @db.Timestamptz(6)
  user            UserAccount @relation(fields: [userId], references: [userId])

  @@map("password_reset")
  @@schema("identity")
}

model Notification {
  notificationId String      @id @map("notification_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  type           String
  data           Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt         DateTime?   @map("read_at") @db.Timestamptz(6)
  user           UserAccount @relation(fields: [userId], references: [userId])

  @@index([userId, createdAt], map: "notification_user_created_key")
  @@map("notification")
  @@schema("identity")
}

model FirstAdminClaim {
  claimKey  String   @id @map("claim_key")
  claimedAt DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)

  @@map("first_admin_claim")
  @@schema("identity")
}

model InstanceSettings {
  settingKey       String  @id @map("setting_key")
  registrationOpen Boolean @map("registration_open")

  @@map("instance_settings")
  @@schema("identity")
}

model MailSettings {
  settingKey     String   @id @map("setting_key")
  provider       String
  fromAddress    String   @map("from_address")
  smtpHost       String   @map("smtp_host")
  smtpPort       Int      @map("smtp_port")
  smtpSecurity   String   @map("smtp_security")
  username       String
  passwordSealed String   @map("password_sealed")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("mail_settings")
  @@schema("identity")
}

model AttemptCounter {
  attemptKey  String    @id @map("attempt_key")
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  requestedAt DateTime? @map("requested_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("attempt_counter")
  @@schema("identity")
}

model ErrorRecord {
  errorRecordId String   @id @map("error_record_id") @db.Uuid
  recordedAt    DateTime @map("recorded_at") @db.Timestamptz(6)
  name          String
  code          String?
  traceId       String?  @map("trace_id")
  context       Json

  @@index([recordedAt])
  @@map("error_record")
  @@schema("observability")
}

generator client {
  provider            = "prisma-client"
  output              = "../../../node_modules/.prisma/offgrid-db"
  importFileExtension = "js"
}
